{
  "expo": {
    "name": "Cookiejar",
    "slug": "cookiejar",
    "version": "1.0.0",
    "scheme": "cookiejar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hayleydodkins.cookiejar"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#CFE8FA",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F1B2D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
