{
  "expo": {
    "name": "Cookiejar",
    "slug": "cookiejar",
    "version": "1.0.0",
    "scheme": "cookiejar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hayleydodkins.cookiejar"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
